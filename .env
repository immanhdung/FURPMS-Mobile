# Cấu hình API URL cho ứng dụng FURPMS
# - Khi chạy trên trình duyệt Web (máy tính): Sử dụng localhost
# - Khi chạy trên điện thoại thật (Expo Go): Thay localhost bằng IP của máy tính (ví dụ: http://192.168.1.50:8080/api)
# - Khi chạy trên API đã triển khai (Staging/Production): Thay bằng domain của backend (ví dụ: https://api.furpms.fpt.edu.vn/api)
EXPO_PUBLIC_API_URL=https://furpms-api-production.up.railway.app
